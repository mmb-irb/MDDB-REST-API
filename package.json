{
  "name": "MDDB-REST-API",
  "version": "0.0.18",
  "description": "MDDB REST API",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "start": "npm-run-all --print-label --parallel asbuild:watch server:watch",
    "build": "npm run asbuild:crdparse; npm run asbuild:binparse; npm run asbuild:f32parse; npm run asbuild:chemfiles",
    "server:watch": "nodemon --inspect --ext js,json,yml index.js",
    "serve": "node index.js",
    "lint": "eslint .",
    "test": "jest",
    "prettier": "prettier --write",
    "coverage": "npm run test -- --coverage --collectCoverageFrom='**/*.js' --collectCoverageFrom='!coverage/**'",
    "asbuild:untouched": "asc assembly/crd_parser.ts -b build/untouched.wasm -t build/untouched.wat --sourceMap --validate --importMemory --debug",
    "asbuild:crdparse": "asc assembly/crd_parser.ts -b build/crd_parser.wasm -t build/crd_parser.wat --sourceMap --validate --importMemory --optimize",
    "asbuild": "npm run asbuild:untouched && npm run asbuild:crdparse",
    "asbuild:watch": "nodemon --watch assembly --ext ts --exec \"npm run asbuild\"",
    "asbuild:chemfiles": "g++ -std=c++17 -o build/chemfiles_bin_converter assembly/chemfiles_bin_converter.cpp -I build/chemfiles/include -L build/chemfiles/lib -lchemfiles",
    "asbuild:binparse": "asc assembly/binary_parser.ts -b build/binary_parser.wasm -t build/binary_parser.wat --sourceMap --validate --importMemory --optimize",
    "asbuild:f32parse": "asc assembly/float32_parser.ts -b build/float32_parser.wasm -t build/float32_parser.wat --sourceMap --validate --importMemory --optimize"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:mmb-irb/MDDB-REST-API.git"
  },
  "keywords": [
    "model",
    "model-cns",
    "central nervous system",
    "membrane",
    "structure",
    "simulation",
    "trajectory",
    "hbp",
    "Human Brain Project"
  ],
  "author": "Aurélien Luciani <aurelien.luciani@irbbarcelona.org>",
  "license": "ISC",
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "assemblyscript": "0.8.0",
    "boxen": "4.1.0",
    "chalk": "3.0.0",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "dotenv": "8.2.0",
    "express": "4.22.3",
    "express-paginate": "1.0.2",
    "geoip-lite": "^2.0.0",
    "jsdom": "30.1.3",
    "mddb-database": "github:mmb-irb/mddb-database",
    "mongodb": "^6.21.0",
    "ngl": "0.10.4",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "pm2": "7.1.0",
    "prettier": "3.9.10",
    "timing-functions": "^2.0.1"
  },
  "lint-staged": {
    "*.{md,json}": [
      "prettier --write"
    ],
    "*.{js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "jest": {
    "coverageReporters": [
      "text-summary",
      "html"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@scarf/scarf": false,
    "mongodb-memory-server": false,
    "unrs-resolver": false
  }
}
